# Cabeçalhos dos arquivos estáticos (Cloudflare Workers Static Assets).

# Segurança em todas as páginas:
# - CSP: só scripts/estilos/fontes/imagens do próprio site; o Turnstile (anti-bot) vem de challenges.cloudflare.com.
#   style-src precisa de 'unsafe-inline' porque o React usa style="" (ex: fundo dos avatares sem imagem).
#   connect-src 'self' cobre a API e o WebSocket da party (mesmo host).
# - frame-ancestors 'none': o site não pode ser aberto dentro de um iframe de outro site (clickjacking).
#   Anúncios no futuro vão exigir liberar os domínios da rede aqui.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
# Imagens de personagem: 7 dias de cache; a URL leva ?v=<anilistId>, então trocar a imagem invalida.
/chars/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# JS/CSS/fontes do Vite têm hash no nome: podem ficar em cache para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
