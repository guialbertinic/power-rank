{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "power-rank",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Rotas do React caem no index.html; /api/* vai sempre para o Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "power-rank",
      "database_id": "5130a3c3-6a0c-4622-9010-ed30ab6df7d1",
      "migrations_dir": "migrations"
    }
  ],
  // Salas da Party (multiplayer): um Durable Object por código de sala, com WebSocket.
  "durable_objects": {
    "bindings": [{ "name": "PARTY", "class_name": "PartyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }],
  // Limite de requisições por IP (server/security.ts). namespace_id é só um identificador único na conta.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_PLAY", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_CASINO", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_PLINKO", "namespace_id": "1004", "simple": { "limit": 200, "period": 60 } }
  ],
  "vars": {
    // Anti-bot na criação de conta (Cloudflare Turnstile). Vazio = desligado. A chave do site é pública; a
    // secreta vai como secret: `npx wrangler secret put TURNSTILE_SECRET`. No dev, as duas vêm do .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFJsPd3NR64n0iH5",
    // Tela de admin (/admin, server/admin.ts): URL do time e AUD da aplicação no Cloudflare Access
    // (Zero Trust → Access → Applications). Vazios = admin fechado em produção. Os e-mails liberados vão como
    // secret: `npx wrangler secret put ADMIN_EMAILS` (separados por vírgula). No dev local o admin é liberado.
    "ACCESS_TEAM_DOMAIN": "https://crimson-dream-8892.cloudflareaccess.com",
    "ACCESS_AUD": "18f3e809e6318d6902bc83157840733bdf174b6cbea154b6f6ba55356952596a"
  },
  "observability": { "enabled": true }
}
