{
  "name": "anime-ranking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "node scripts/validate-data.mjs",
    "fetch:images": "node --env-file-if-exists=.env scripts/fetch-images.mjs",
    "db:migrate:local": "wrangler d1 migrations apply power-rank --local",
    "db:migrate:remote": "wrangler d1 migrations apply power-rank --remote",
    "deploy": "npm run build && wrangler deploy",
    "rescore": "node scripts/rescore.mjs",
    "import:image": "node scripts/import-image.mjs",
    "e2e:api": "node e2e/api.mjs",
    "e2e:ui": "node e2e/ui.mjs",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "characters:sync": "node scripts/sync-characters.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
